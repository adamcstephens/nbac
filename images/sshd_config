Port @SSH_PORT@
HostKey /etc/ssh/ssh_host_ed25519_key
AllowGroups nbac-ssh
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
# Outside $HOME: with a mounted home the user's .ssh is the host's, which
# injection must neither read nor overwrite.
AuthorizedKeysFile /etc/ssh/authorized_keys.d/%u
UseDNS no
# Nix opens bursts of parallel connections from one source address; the
# default MaxStartups drops part of the burst and per-source penalties then
# lock the address out entirely.
MaxStartups 64
PerSourcePenalties no
Subsystem sftp internal-sftp
